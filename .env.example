# Salin menjadi .env.local lalu isi. File .env.local TIDAK ikut ke GitHub.
# Hal yang sama diisi di Vercel: Project → Settings → Environment Variables.

# URL database Turso (berawalan libsql://). Untuk uji lokal tanpa internet bisa: file:./local.db
TURSO_DATABASE_URL=libsql://nama-database-organisasi.turso.io

# Auth token Turso (rahasia). Tidak perlu jika memakai file:
TURSO_AUTH_TOKEN=

# Kode akses pengguna aplikasi (sangat disarankan). Kosong = siapa pun yang punya link bisa mengubah order.
ACCESS_CODE=
